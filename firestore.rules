rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
    
    function userId() {
      return request.auth.uid;
    }
    
    function userEmail() {
      return request.auth.token.email;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        userEmail() == 'ttal5058@gmail.com' ||
        exists(/databases/$(database)/documents/users/$(userId())) &&
        get(/databases/$(database)/documents/users/$(userId())).data.role == 'admin'
      );
    }
    
    function isOwner(ownerId) {
      return isSignedIn() && userId() == ownerId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // --- ENTITY VALIDATION HELPERS ---

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'role', 'isApproved', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.role in ['admin', 'teacher', 'student', 'parent'] &&
             data.isApproved is bool &&
             data.createdAt is timestamp;
    }

    function isValidJoinRequest(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'country', 'phone', 'identityCode', 'status', 'createdAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['teacher', 'student', 'parent'] &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.createdAt is timestamp;
    }

    function isValidAssignment(data) {
      return data.keys().hasAll(['studentId', 'teacherId', 'type', 'title', 'status', 'createdAt']) &&
             data.studentId is string && data.teacherId is string &&
             data.type in ['quran', 'tuhfat-al-atfal', 'homework', 'exam'] &&
             data.status in ['assigned', 'submitted', 'graded'] &&
             data.createdAt is timestamp;
    }

    // --- MATCH BLOCKS ---

    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && uid == userId() && isValidUser(incoming()) && incoming().role != 'admin';
      allow update: if isAdmin() || (isOwner(uid) && isValidUser(incoming()) && incoming().role == existing().role && incoming().isApproved == existing().isApproved);
      allow delete: if isAdmin();
    }

    // Join Requests
    match /joinRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if true; // Public can submit requests
      allow update, delete: if isAdmin();
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (isAdmin() || userId() == existing().studentId || userId() == existing().teacherId);
      allow create: if isSignedIn() && (isAdmin() || incoming().teacherId == userId()) && isValidAssignment(incoming());
      allow update: if isSignedIn() && (isAdmin() || userId() == existing().teacherId || (userId() == existing().studentId && incoming().diff(existing()).affectedKeys().hasOnly(['status'])));
      allow delete: if isAdmin() || (isSignedIn() && userId() == existing().teacherId);
    }

    // Recitations
    match /recitations/{recitationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (incoming().studentId == userId() || isAdmin());
      allow update, delete: if isAdmin() || (isSignedIn() && userId() == existing().studentId);
    }

    // Messages
    match /messages/{messageId} {
      allow read: if isSignedIn() && (userId() == existing().senderId || userId() == existing().recipientId);
      allow create: if isSignedIn() && incoming().senderId == userId();
      allow update: if isSignedIn() && userId() == existing().recipientId && incoming().diff(existing()).affectedKeys().hasOnly(['readAt']);
      allow delete: if false;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (existing().userId == null || existing().userId == userId());
      allow create: if isAdmin();
      allow update: if isSignedIn() && existing().userId == userId() && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAdmin();
    }

    // Admin Messages
    match /adminMessages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if true; // Public can send messages, but API will handle validation/blocking
    }

    // Blocked Senders
    match /blockedSenders/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
