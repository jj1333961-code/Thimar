# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/teacher

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Keys (required for the application)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# GitHub Sync (optional)
GITHUB_TOKEN=your-github-token
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
GITHUB_BRANCH=main

# Authentication
# Optional in Dyad; the app uses a stable local fallback when it is not set.
THIMAR_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
THIMAR_LOCAL_DATA_FILE=.data/teacher-platform.json

# Development
DEV_ASSISTANT_AUTO_APPLY=false
